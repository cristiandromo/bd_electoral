# URL de conexión MySQL (bditagui es la base definida en bd.sql)
DATABASE_URL=mysql+pymysql://root:@localhost:3306/bditagui

# Clave secreta para firmar los JWT (¡cámbiala en producción!)
JWT_SECRET=cambia-esta-clave-por-una-segura-en-produccion
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Solo si quieres que la API cree las tablas automáticamente al arrancar
# (normalmente las creas ejecutando bd.sql). Valores: true | false
CREATE_TABLES=false

# Datos del administrador inicial que crea `python -m app.seed_admin`
ADMIN_EMAIL=admin@itagui.com
ADMIN_PASSWORD=Admin123!
ADMIN_NOMBRES=Administrador
ADMIN_APELLIDOS=del Sistema
